rules_version = '2';

// Firestore security rules for the shared Kauā Fragrances project (perfume-3b075).
// Used by BOTH the Oil Tracker admin app and the kf-publicsite storefront.
//
// SETUP: the admin UID is already filled in below. To change it, replace the UID
// in isAdmin(), then paste this whole file into
// console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal Oil Tracker sync — no login; knowing the 6+ char code grants access.
    match /workspaces/{code} {
      allow get, write: if code.size() >= 6;
      allow list: if false;
    }

    // Shop catalogue — anyone can read; only the admin can change it.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Editable storefront content (banners, hero, announcement) — public read, admin write.
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer profiles — each customer can read/write only their own document.
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Orders:
    //  - a customer (or guest) may place one for themselves;
    //  - a signed-in customer may read their own orders;
    //  - only the admin can read all / update / delete.
    match /orders/{id} {
      allow create: if isValidNewOrder() && (
        request.resource.data.uid == null ||
        (request.auth != null && request.resource.data.uid == request.auth.uid)
      );
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'iQjj1HHAUAM6BzWGcoYWepQCpRx2';
    }

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.reference is string
        && d.total is number
        && d.total >= 0
        && d.items is list;
    }
  }
}
