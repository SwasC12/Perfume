rules_version = '2';

// Firestore security rules for the shared Kauā Fragrances project (perfume-3b075).
// Used by BOTH the Oil Tracker admin app and the kf-publicsite storefront.
//
// SETUP: replace PASTE_ADMIN_UID below with your admin account's UID
// (Firebase console -> Authentication -> Users -> copy the User UID),
// then paste this whole file into console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal Oil Tracker sync — no login; knowing the 6+ char code grants access.
    match /workspaces/{code} {
      allow get, write: if code.size() >= 6;
      allow list: if false;
    }

    // Shop catalogue — anyone can read; only the admin can change it.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — customers may place one; only the admin can read/manage them.
    match /orders/{id} {
      allow create: if isValidNewOrder();
      allow read, update, delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_ADMIN_UID';
    }

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.reference is string
        && d.total is number
        && d.items is list
        && d.total >= 0;
    }
  }
}
