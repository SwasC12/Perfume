rules_version = '2';

// Firestore security rules for the shared Kauā Fragrances project (perfume-3b075).
// Used by BOTH the Oil Tracker admin app and the kf-publicsite storefront.
//
// SETUP: the admin UID is already filled in below. To change it, replace the UID
// in isAdmin(), then paste this whole file into
// console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal Oil Tracker sync — no login; knowing the 6+ char code grants access.
    match /workspaces/{code} {
      allow get, write: if code.size() >= 6;
      allow list: if false;
    }

    // Shop catalogue — anyone can read; only the admin can change it.
    // Exception: a shopper posting a review may bump the cached rating aggregate
    // (ratingSum/ratingCount) by one review's worth — nothing else.
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.ratingSum >= resource.data.get('ratingSum', 0) + 1
        && request.resource.data.ratingSum <= resource.data.get('ratingSum', 0) + 5
      );
    }

    // Product reviews — anyone can read and post a valid review; admin moderates.
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow update, delete: if isAdmin();
    }

    // Editable storefront content (banners, hero, announcement) — public read, admin write.
    match /siteContent/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings (delivery, banking, whatsapp…) — public read, admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public order-status lookup (by reference) for the Track page.
    // Created when an order is placed; only the admin changes it afterwards.
    // get = look up one known reference (public); list = enumerate all (admin only).
    match /orderStatus/{ref} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Customer profiles — each customer manages their own; the admin can view all.
    match /customers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Discount / promo codes — a shopper can validate a code they already know
    // (get), but nobody can enumerate every code (list = admin only). Admin writes.
    // Anyone may increment usedCount by exactly 1 (redemption tracking); nothing else.
    match /discounts/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
        && request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    // "Notify me when back in stock" requests — anyone can create; only admin reads/manages.
    match /restockRequests/{id} {
      allow create: if request.resource.data.notified == false
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() < 200
        && request.resource.data.productId is string;
      allow read, update, delete: if isAdmin();
    }

    // Orders:
    //  - a customer (or guest) may place one for themselves;
    //  - a signed-in customer may read their own orders;
    //  - only the admin can read all / update / delete.
    match /orders/{id} {
      allow create: if isAdmin() || (isValidNewOrder() && (
        request.resource.data.uid == null ||
        (request.auth != null && request.resource.data.uid == request.auth.uid)
      ));
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Business expenses (Budgeting tab) — admin only, never public.
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'iQjj1HHAUAM6BzWGcoYWepQCpRx2';
    }

    function isValidNewOrder() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.reference is string
        && d.total is number
        && d.total >= 0
        && d.items is list;
    }
  }
}
